// Neapolitan Artistic Heritage Dialogue System — actual processing pipeline
digraph Neapolitan_Dialogue_Pipeline {
	bgcolor="#ffffff" compound=true dpi=300 margin=0.1 nodesep=0.25 rankdir=TB ranksep=0.28 splines=spline
	node [fontname=Helvetica fontsize=9.0 shape=none]
	edge [arrowsize=0.7 color="#333333" fontcolor="#111111" fontname=Helvetica fontsize=7.8 penwidth=1.0]
	subgraph cluster_setup {
		bgcolor="#fbfbfb" color="#777777" fontcolor="#000000" fontname="Helvetica-Bold" fontsize=8.5 label="  ONE-TIME SETUP (scripts/build_graph.py)" labeljust=l margin=10 style="rounded,dashed"
		dbpedia [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#333333">
        <TR><TD BGCOLOR="#1a1a1a" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="9.5"><B>DBpedia SPARQL Query</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">DBpedia SPARQL endpoint (dbpedia.org/sparql)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">Artist biographies, abstracts, URIs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">src/data_pipeline/sparql_client.py</FONT></TD></TR>
    </TABLE>
    >]
		curated [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#333333">
        <TR><TD BGCOLOR="#1a1a1a" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="9.5"><B>Curated Catalog</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">8 artworks, 5 venues, structural facts</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">(title, artist, year, address)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">src/data_pipeline/curated_dataset.py</FONT></TD></TR>
    </TABLE>
    >]
		cache [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#333333">
        <TR><TD BGCOLOR="#1a1a1a" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="9.5"><B>Local Cache</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">Merged snapshot written to disk</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">data/dbpedia_cache.json</FONT></TD></TR>
    </TABLE>
    >]
		dbpedia -> cache
		curated -> cache
	}
	input [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#333333">
        <TR><TD BGCOLOR="#1a1a1a" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="9.5"><B>1. User Turn</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">Microphone audio or typed text</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">app.py (Streamlit) or scripts/interactive_cli.py</FONT></TD></TR>
    </TABLE>
    >]
	asr [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#333333">
        <TR><TD BGCOLOR="#1a1a1a" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="9.5"><B>2. Speech Recognition</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">OpenAI Whisper, 'small' checkpoint, local</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">16 kHz mono, peak-normalized audio</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">Domain prompt biases decoding</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">src/speech/asr.py  (voice input only)</FONT></TD></TR>
    </TABLE>
    >]
	normalize [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#333333">
        <TR><TD BGCOLOR="#1a1a1a" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="9.5"><B>3. Text Normalization</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">Lowercasing + regex normalization</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">'works for mercy' -&gt; 'works of mercy'</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">'capo di monte' -&gt; 'capodimonte'</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">shared by chatbot.py and inconsistency.py</FONT></TD></TR>
    </TABLE>
    >]
	entities [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#333333">
        <TR><TD BGCOLOR="#1a1a1a" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="9.5"><B>4. Entity Extraction &amp; Coreference</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">Artwork / artist / location keyword match</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">Pronoun resolution against dialogue state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">('it', 'he', 'there' -&gt; active entity)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">src/dialogue/state_tracker.py</FONT></TD></TR>
    </TABLE>
    >]
	guard [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#333333">
        <TR><TD BGCOLOR="#1a1a1a" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="9.5"><B>5. Inconsistency Check</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">5 rule checks against the graph:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">artist / venue / city mismatch,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">out-of-scope artist, context contradiction</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">src/dialogue/inconsistency.py</FONT></TD></TR>
    </TABLE>
    >]
	"graph" [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#333333">
        <TR><TD BGCOLOR="#1a1a1a" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="9.5"><B>6. Knowledge Graph Lookup</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">(:Artist)-[:PAINTED]-&gt;(:Artwork)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">-[:LOCATED_AT]-&gt;(:Location)-[:IN_CITY]-&gt;(:City)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">Neo4j (primary) / SQLite (fallback)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">src/data_pipeline/graph_db.py</FONT></TD></TR>
    </TABLE>
    >]
	respond [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#333333">
        <TR><TD BGCOLOR="#1a1a1a" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="9.5"><B>7. Response Generation</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">Template chosen by question type</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">(location / authorship / dimensions / date)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">filled with the graph fields retrieved above</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">src/dialogue/chatbot.py</FONT></TD></TR>
    </TABLE>
    >]
	state [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#333333">
        <TR><TD BGCOLOR="#1a1a1a" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="9.5"><B>8. Dialogue State Update</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">Updates active artist / artwork / location</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">Appends turn to conversation history</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">src/dialogue/state_tracker.py</FONT></TD></TR>
    </TABLE>
    >]
	tts [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#333333">
        <TR><TD BGCOLOR="#1a1a1a" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="9.5"><B>9. Speech Synthesis</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">Microsoft Edge-TTS (en-GB-RyanNeural)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">pyttsx3 offline fallback on failure</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">src/speech/tts.py  (voice output only)</FONT></TD></TR>
    </TABLE>
    >]
	output [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#333333">
        <TR><TD BGCOLOR="#1a1a1a" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="9.5"><B>10. Response Delivered</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">Text reply + optional audio playback</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="8.5" COLOR="#222222">rendered in the Streamlit page or terminal</FONT></TD></TR>
    </TABLE>
    >]
	input -> asr [label=" if voice"]
	input -> normalize [label=" if text" style=dashed]
	asr -> normalize [label=" transcript"]
	normalize -> entities
	entities -> guard [label=" candidate entities + state"]
	guard -> "graph" [label=" no contradiction found"]
	guard -> respond [label=" contradiction found -> corrective reply" color="#000000" penwidth=1.3 style=dashed]
	"graph" -> respond [label=" matched facts"]
	respond -> state
	state -> tts [label=" if voice mode"]
	state -> output [label=" if text mode" style=dashed]
	tts -> output
	cache -> "graph" [label="  populates" color="#777777" constraint=false style=dotted]
}
